<!-- Resources/DisplayResources.xaml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CampInfoBoard.Converters">

    <!-- Converters -->
    <converters:BoolToVisibilityConverter
        x:Key="BoolToVisibility"/>

    <converters:NullToVisibilityConverter
        x:Key="NullToVisibility"/>

    <converters:ImagePathToBitmapConverter
        x:Key="ImagePathToBitmapConverter"/>

    <converters:UVIndexToBrushConverter
        x:Key="UVIndexToBrushConverter"/>

    <converters:ScaleValueConverter
        x:Key="ScaleValueConverter"/>

    
    <!-- Move the existing shared text and panel styles here. -->
    <Style x:Key="DisplayTinyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=20}"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayMutedTextBrush}"/>
    </Style>

    <Style x:Key="DisplayAccentTinyTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayTinyTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DisplayAccentTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DisplayLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=24}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayAccentTextBrush}"/>
    </Style>

    <Style x:Key="DisplaySoftLabelTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayLabelTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DisplayMutedTextBrush}"/>
    </Style>

    <Style x:Key="DisplayMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=28}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayTextBrush}"/>
    </Style>

    <Style x:Key="DisplayMutedMetaTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayMetaTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DisplayMutedTextBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="DisplayAccentMetaTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayMetaTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DisplayAccentTextBrush}"/>
    </Style>

    <Style x:Key="DisplayBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=36}"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayTextBrush}"/>
    </Style>

    <Style x:Key="DisplayLargeBodyTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayBodyTextStyle}">
        <Setter Property="FontSize"
                        Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=40}"/>
    </Style>
    <Style x:Key="DisplayValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=40}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayTextBrush}"/>
    </Style>

    <Style x:Key="DisplayCaptionTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource DisplayValueTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="DisplayTemperatureTextStyle"
                   TargetType="TextBlock">
        <Setter Property="FontSize"
                        Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=48}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayTextBrush}"/>
    </Style>

    <Style x:Key="DisplayTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"
                    Value="{Binding DataContext.Settings.DisplayFontScale,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleValueConverter},
                                ConverterParameter=54}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DisplayTextBrush}"/>
    </Style>

    <Style x:Key="DisplayBannerTextStyle"
                    TargetType="TextBlock"
                    BasedOn="{StaticResource DisplayMetaTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DisplayAccentTextBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>


    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DisplayCardBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="LargePanelCardStyle"
                TargetType="Border"
                BasedOn="{StaticResource PanelCardStyle}">
        <Setter Property="Padding" Value="28"/>
    </Style>

    <Style x:Key="StrongPanelCardStyle"
                TargetType="Border"
                BasedOn="{StaticResource PanelCardStyle}">
        <Setter Property="Background" Value="{DynamicResource DisplayStrongCardBrush}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="34"/>
    </Style>


    <Style x:Key="BannerPanelStyle"
                   TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DisplayCardBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

</ResourceDictionary>